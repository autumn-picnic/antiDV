# Same Clerk application as the XiaoAn backend. Keys below are placeholders only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/chat
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/chat

# Backend ORIGIN only, without /v1. Add FRONTEND_ORIGIN to backend Clerk authorized parties.
BACKEND_API_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://localhost:3000
# Set only if production Clerk/site cookies use a shared parent domain, e.g. example.com.
FRONTEND_COOKIE_DOMAIN=
# Optional gateway key must NOT use Authorization (reserved for Clerk session token).
BACKEND_API_KEY=
BACKEND_API_KEY_HEADER=x-api-key

# Same PostgreSQL DATABASE as the backend account service, using a separate least-privilege role.
# Standard PostgreSQL URI, NOT SQLAlchemy postgresql+psycopg:// syntax. Require TLS in production.
# Apply db/migrations/001_answer_feedback.sql explicitly before enabling feedback/admin.
CHATFLOW_DATABASE_URL=

# Homepage contact messages also use CHATFLOW_DATABASE_URL.
# Apply db/migrations/002_contact_feedback.sql before enabling the contact API.
# CONTACT_ADMIN_SECRET and DATA_DIR are retired; GET /api/contact requires Clerk admin.
